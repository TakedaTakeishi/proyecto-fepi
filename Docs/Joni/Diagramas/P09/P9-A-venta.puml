@startuml P9-A-venta
skinparam shadowing false
skinparam roundCorner 14
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam backgroundColor #101014
skinparam TitleFontColor #F4F4F5
skinparam TitleFontSize 15
skinparam SwimlaneWidth 170
skinparam ActivityStartColor #F97316
skinparam ActivityEndColor #F97316
skinparam ActivityStartBorderColor #F97316
skinparam ActivityEndBorderColor #F97316
skinparam ActivityBorderColor #F97316
skinparam ActivityBackgroundColor #1B1B21
skinparam ActivityFontColor #F4F4F5
skinparam ActivityDiamondBorderColor #FB923C
skinparam ActivityDiamondBackgroundColor #101014
skinparam ActivityDiamondFontColor #FDBA74
skinparam ArrowColor #F97316
skinparam ArrowFontColor #FDBA74
skinparam ArrowFontSize 10
skinparam SwimlaneTitleFontColor #FB923C
skinparam SwimlaneTitleBackgroundColor #0A0A0D
skinparam SwimlaneTitleFontSize 12
title P9·A — Venta (semilla / conos / planta)
|R1·R2 Solicitante|
start
:A0 · consulta catálogo y disponibilidad;
|R8 Contab.|
:A1 · elabora el FUP;
|R1·R2 Solicitante|
:A2 · paga en centro autorizado (R9)\ny obtiene comprobante;
|R8 Contab.|
:A3 · sella FUP "Pagado";
if (¿Producto?) then (semilla)
  |R3 Ventanilla|
  :A4 · indica punto de recogida;
  |R4 Banco · R5 Beneficio|
  :A5 · entrega + formato de salida\nfoliado con datos de lote;
  :A6 · bitácora y baja de inventario;
elseif (conos) then
  |R4 Banco · R5 Beneficio|
  :A-C5 · conos: entrega en Beneficio\n(sin formato propio);
else (planta)
  |R3 Ventanilla|
  :A-P4 · genera vale de salida\nde planta;
  |R6 Vivero|
  :A-P5 · entrega contra vale + FUP "Pagado";
  :A-P6 · baja de inventario + informe DRF;
endif
|R8 Contab.|
:A7 · póliza de ingresos + SPEI;
|R11 Archivo|
:A8 · archivo del expediente por folio;
stop
@enduml